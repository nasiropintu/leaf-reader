{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Leaf",
  "version": "1.0.0",
  "identifier": "com.nasirpintu.leaf",
  "build": {
    "frontendDist": "../dist/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:static",
    "beforeBuildCommand": "npm run build:static"
  },
  "app": {
    "windows": [
      {
        "title": "Leaf — Document Reader",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "100% free, private-by-design, local-first document reader",
    "longDescription": "Leaf is an open-source, local-first document reader crafted by NasirPintu. All documents are parsed and rendered directly on your device without cloud uploads or accounts.",
    "copyright": "Copyright © 2026 NasirPintu",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Adobe Portable Document Format",
        "role": "Viewer"
      },
      {
        "ext": ["docx"],
        "name": "Word Document",
        "description": "Microsoft Word Document",
        "role": "Viewer"
      },
      {
        "ext": ["xlsx", "xls", "csv", "ods"],
        "name": "Spreadsheet",
        "description": "Excel or CSV Spreadsheet",
        "role": "Viewer"
      },
      {
        "ext": ["pptx"],
        "name": "PowerPoint Presentation",
        "description": "Microsoft PowerPoint Presentation",
        "role": "Viewer"
      },
      {
        "ext": ["epub"],
        "name": "EPUB Book",
        "description": "Electronic Publication E-Book",
        "role": "Viewer"
      },
      {
        "ext": ["txt", "md", "markdown", "rtf", "odt", "html", "htm"],
        "name": "Text & Markdown",
        "description": "Plain text and Markdown documents",
        "role": "Viewer"
      },
      {
        "ext": ["png", "jpg", "jpeg", "webp", "gif"],
        "name": "Image Document",
        "description": "Standard images",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libappindicator3-1",
          "librsvg2-2"
        ]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
