# Leaf Environment Configuration
# Leaf is a local-first document reader PWA that runs entirely in the browser.
# No API keys or database connections are required for client-side document reading.

# Optional server configuration (for containerized / Node.js hosting)
PORT=3000
NODE_ENV=development

# Optional database URL (if using backend persistence extensions)
# DATABASE_URL=mysql://user:password@localhost:3306/leaf
