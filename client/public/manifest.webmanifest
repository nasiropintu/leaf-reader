{
  "name": "Leaf — Free Document Reader",
  "short_name": "Leaf",
  "description": "A 100% free, private-by-design, local-first document reader PWA crafted with love by NasirPintu.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e8f1f5",
  "theme_color": "#315b78",
  "icons": [
    { "src": "./icons/leaf-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icons/leaf-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icons/leaf-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "./icons/leaf.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
